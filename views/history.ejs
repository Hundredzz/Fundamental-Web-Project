<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History Page</title>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
    <style>
        body {
            margin: 0;
            background: url(/img/big-background.png) repeat, #3B010B;
            background-size: cover;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .container {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            background-color: #75162D;
            width: 80%;
            padding-block: 1%;
            gap: 20px;
        }

        h1 {
            text-align: center;
            color: #75162D;
        }

        input {
            width: 20%;
            padding: 15px;
            margin: 0.5%;
            background-color: #75162D;
            border: 1px solid #F2D9A0;
            color: #F2D9A0;
            border-radius: 5px;
            outline: none;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(70%) sepia(50%) saturate(400%) hue-rotate(10deg);
            cursor: pointer;
        }

        input::placeholder {
            color: #F2D9A0;
            /* ปรับให้จางลงนิดนึงเพื่อให้แยกออกว่าคือคำแนะนำ */
        }

        /* 3. สำหรับ Browser ตระกูล Safari / iOS (เผื่อมันดื้อ) */
        input::-webkit-input-placeholder {
            color: #F2D9A0;
        }

        /* 4. สำหรับกรณี Browser เติมคำให้อัตโนมัติ (Autofill) */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: #F2D9A0 !important;
            box-shadow: 0 0 0px 1000px #75162D inset;
            transition: all 0.3s ease-in-out;
        }

        input:hover {
            border-color: #3B010B;
            background-color: #75162D;
            cursor: pointer;
        }
        input:focus {
            border-color: #3B010B;
            background-color: #75162D;
            box-shadow: 0 0 8px #3B010B;
            transform: scale(1.02);
        }

        select {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0.5%;
            background-color: #75162D;
            border: 1px solid #F2D9A0;
            border-radius: 5px;
            color: #F2D9A0;
            padding: 15px;
        }

        button {
            display: flex;
            width: fit-content;
            margin: 0.5%;
            padding: 15px;
            background: linear-gradient(45deg, #f2e5c6, #F2D9A0);
            color: #75162D;
            border: 1px solid #F2D9A0;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            align-items: center;
            justify-content: center;
        }
        button:hover {
            border-color: #3B010B;
            transform: translateY(-3px) scale(1.03);
        }
        button:active {
            transform: translateY(1px) scale(0.98);
            box-shadow: 0 0 10px #3B010B;
        }

        @media screen and (max-width: 800px) {
            .brand-side {
                flex: 0;
            }
        }

        table {
            width: 80%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            background-color: #75162D;
            color: #F2D9A0;
            padding: 10px;
            border: 1px solid #3B010B;
        }

        td {
            color: #3B010B;
            padding: 10px;
            border: 1px solid #3B010B;
            text-align: center;
            
        }        
        tr{
            background-color: #F2D9A0;
        }
        tr:nth-child(odd) {
            background-color: #F2E5C5;
        }

        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24
        }

        .search-icon {
            font-size: 20px;
            margin-right: 1%;
        }
    </style>
</head>

<body>
    <h1>ประวัติการรับ-จ่ายสินค้า</h1>

    <form action="/history" method="post" class="container">
        <input type="text" name="username" id="username" placeholder="ระบุชื่อสินค้า">
        <input type="date" name="data" id="date">
        <select name="type" id="type">
            <option value="">เลือกประเภทรายการ</option>
            <option value="รับสินค้า">รับสินค้า</option>
            <option value="จ่ายสินค้า">จ่ายสินค้า</option>
        </select>
        <button type="submit"><span
                class="material-symbols-outlined search-icon">search</span><span>ค้นหา</span></button>
    </form>

    <table>
        <thead>
            <tr>
                <th>รหัสรายการ</th>
                <th>ชื่อสินค้า</th>
                <th>จำนวน</th>
                <th>วันที่</th>
                <th>ประเภทรายการ</th>
                <th>ผู้ทำรายการ</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>แป้ง</td>
                <td>5000</td>
                <td>02-25-65</td>
                <td>จ่าย</td>
                <td>บัญชี</td>
            </tr>
            <tr>
                <td>1</td>
                <td>แป้ง</td>
                <td>5000</td>
                <td>02-25-65</td>
                <td>จ่าย</td>
                <td>บัญชี</td>
            </tr>
        </tbody>
    </table>

</body>

</html>