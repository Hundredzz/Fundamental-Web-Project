<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการผู้ใช้งาน</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/search.css">
    <style>
        .big{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .container {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            background-color: #75162D;
            width: 80%;
            padding-block: 1%;
            gap: 20px;
        }
        h1 {
            text-align: center;
            color: #75162D;
        }

        @media screen and (max-width: 800px) {
            .brand-side {
                flex: 0;
            }
        }
        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24
        }
        .search-icon {
            font-size: 20px;
            margin-right: 1%;
        }
        img{
            width: 36px;
            margin: 15px;
            height: 36px;
        }
    </style>
</head>
<body>
    <div class="big">
        <h1>จัดการผู้ใช้งาน</h1>

        <form action="/history" method="post" class="container">
            <input type="text" name="username" id="username" placeholder="ระบุชื่อสินค้า">
            <input type="date" name="data" id="date">
            <select name="type" id="type">
                <option value="">เลือกประเภทรายการ</option>
                <option value="รับสินค้า">รับสินค้า</option>
                <option value="จ่ายสินค้า">จ่ายสินค้า</option>
            </select>
            <button type="submit"><span
                    class="material-symbols-outlined search-icon">search</span><span>ค้นหา</span></button>
        </form>

        <table>
            <thead>
                <tr>
                    <th>รหัสพนักงาน</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>ชื่อ-นามสกุล</th>
                    <th>ตำแหน่งงาน</th>
                    <th>บทบาท</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>แป้ง</td>
                    <td>วรรณณิศา อมรวงศ์ไพบูลย์</td>
                    <td>02-25-65</td>
                    <td>จ่าย</td>
                    <td><a href="..."><img src="/img/edit-icon.svg"></a>
                    <a href="..."><img src="/img/delete-icon.svg"></a> 
                    <a href="..."><img src="/img/home-icon.svg"></a></td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>แป้ง</td>
                    <td>5000</td>
                    <td>02-25-65</td>
                    <td>จ่าย</td>
                    <td>บัญชี</td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>