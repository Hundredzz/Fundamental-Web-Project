<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head') %>
    <title>จัดการผู้ใช้งาน</title>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/button.css">
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/popupManage.css">
    <script src="/script/confirmPopUp.js" defer></script>
    <style>
        .main-content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            max-height: 80vh;
        }

        .container {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            background-color: #75162D;
            width: 80%;
            padding-block: 1%;
            gap: 10px;
        }

        h1 {
            text-align: center;
            color: #75162D;
        }

        @media screen and (max-width: 800px) {
            .brand-side {
                flex: 0;
            }
        }

        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24
        }

        .search-icon {
            font-size: 20px;
            margin-right: 1%;
        }

        .icon {
            width: 36px;
            margin: 15px;
            height: 36px;
            cursor: pointer;
        }
        
    </style>
</head>

<body>
    <%- include('nav') %>
        <div id="main-content" class="main-content">
        <h1>จัดการผู้ใช้งาน</h1>

        <form action="/manage" method="get" class="container">
            <input type="text" name="id" id="id" placeholder="ระบุรหัสพนักงาน">
            <input type="text" name="username" id="username" placeholder="ระบุชื่อผู้ใช้">
            <input type="text" name="name" id="name" placeholder="ระบุชื่อ-นามสกุล">

            <select name="job_title" id="job_title">
        <option value="">ตำแหน่งงาน</option>
        <option value="เจ้าหน้าที่คลัง">เจ้าหน้าที่คลัง</option>
        <option value="ผู้จัดการ">ผู้จัดการ</option>
    </select>
    
    <select name="role" id="role">
        <option value="">บทบาท</option>
        <option value="Admin">Admin</option>
        <option value="Staff">Staff</option>
    </select>
            <button type="submit" class="style-button"><span
                    class="material-symbols-outlined search-icon">search</span><span>ค้นหา</span></button>
        </form>
        <div class="table-scroll-container">
        <table>
            <thead>
                <tr>
                    <th>รหัสพนักงาน</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>ชื่อ-นามสกุล</th>
                    <th>ตำแหน่งงาน</th>
                    <th>บทบาท</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% if (users && users.length > 0) { %>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.employee_id %></td>
                <td><%= user.username %></td>
                
                <td><%= user.first_name %> <%= user.last_name %></td> 
                
                <td><%= user.job_title %></td>
                <td><%= user.role %></td>
                <td>
                    <img src="/img/edit-icon.svg" id="editData-<%= user.username %>" class="icon">
                    
                    <img src="/img/delete-icon.svg" id="deleteData-<%= user.username %>"
                         onclick="showDetail('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้', '<%= user.username %>', '/api/delete-user/<%= user.username %>')" 
                         class="icon">
                         
                    <img src="/img/notban-icon.svg" id="ban-<%= user.username %>" class="icon">
                </td>
            </tr>
        <% }) %>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.employee_id %></td>
                <td><%= user.username %></td>
                
                <td><%= user.first_name %> <%= user.last_name %></td> 
                
                <td><%= user.job_title %></td>
                <td><%= user.role %></td>
                <td>
                    <img src="/img/edit-icon.svg" id="editData-<%= user.username %>" class="icon">
                    
                    <img src="/img/delete-icon.svg" id="deleteData-<%= user.username %>"
                         onclick="showDetail('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้', '<%= user.username %>', '/api/delete-user/<%= user.username %>')" 
                         class="icon">
                         
                    <img src="/img/notban-icon.svg" id="ban-<%= user.username %>" class="icon">
                </td>
            </tr>
        <% }) %>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.employee_id %></td>
                <td><%= user.username %></td>
                
                <td><%= user.first_name %> <%= user.last_name %></td> 
                
                <td><%= user.job_title %></td>
                <td><%= user.role %></td>
                <td>
                    <img src="/img/edit-icon.svg" id="editData-<%= user.username %>" class="icon">
                    
                    <img src="/img/delete-icon.svg" id="deleteData-<%= user.username %>"
                         onclick="showDetail('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้', '<%= user.username %>', '/api/delete-user/<%= user.username %>')" 
                         class="icon">
                         
                    <img src="/img/notban-icon.svg" id="ban-<%= user.username %>" class="icon">
                </td>
            </tr>
        <% }) %>
    <% } else { %>
        <tr>
            <td colspan="6" style="text-align: center; padding: 20px;">ไม่พบข้อมูลผู้ใช้งาน</td>
        </tr>
    <% } %>
            </tbody>
        </table>
        </div>
    </div>

    <div id="confirmPopup" class="popup-overlay">
    </div>
</body>

</html>