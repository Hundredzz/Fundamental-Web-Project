<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head') %>
        <title>จัดการผู้ใช้งาน</title>
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
        <link rel="stylesheet" href="/css/table.css">
        <link rel="stylesheet" href="/css/button.css">
        <link rel="stylesheet" href="/css/search.css">
        <link rel="stylesheet" href="/css/popupManage.css">
        <script src="/script/confirmPopUp.js" defer></script>
        <style>
            .main-content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                max-height: 80vh;
            }

            .container {
                display: flex;
                flex-direction: row;
                justify-content: center;
                align-items: center;
                background-color: #75162D;
                width: 80%;
                padding-block: 1%;
                gap: 10px;
                
                position: relative;
            }

            h1 {
                text-align: center;
                color: #75162D;
            }

            @media screen and (max-width: 800px) {
                .brand-side {
                    flex: 0;
                }
            }

            .material-symbols-outlined {
                font-variation-settings:
                    'FILL' 0,
                    'wght' 400,
                    'GRAD' 0,
                    'opsz' 24
            }

            .search-icon {
                font-size: 20px;
                margin-right: 1%;
            }

            .icon {
                width: 36px;
                margin: 15px;
                height: 36px;
                cursor: pointer;
            }

            .add-user-btn{
                position: absolute;
                top: -80px;
                right: 0;
            }
        </style>
</head>

<body>
    <%- include('nav') %>
        <div id="main-content" class="main-content">
            <h1>จัดการผู้ใช้งาน</h1>
            
            <form id="search-form" onsubmit="event.preventDefault(); searchUsers();" class="container">
                <input type="text" name="id" id="id" placeholder="ระบุรหัสพนักงาน">
                <input type="text" name="username" id="username" placeholder="ระบุชื่อผู้ใช้">
                <input type="text" name="name" id="name" placeholder="ระบุชื่อ-นามสกุล">

                <select name="role" id="role">
                    <option value="">บทบาท</option>
                    <option value="ผู้จัดการ">ผู้จัดการ</option>
                    <option value="เจ้าหน้าที่คลัง">เจ้าหน้าที่คลัง</option>
                </select>
                <button type="submit" class="style-button"><span
                        class="material-symbols-outlined search-icon">search</span><span>ค้นหา</span></button>
                <button class="style-button add-user-btn" type="button" onclick="window.location.href = '/add-user'">เพิ่มผู้ใช้</button>
            </form>
            <div class="table-scroll-container">
                <table>
                    <thead>
                        <tr>
                            <th>รหัสพนักงาน</th>
                            <th>ชื่อผู้ใช้</th>
                            <th>ชื่อ-นามสกุล</th>
                            <th>บทบาท</th>
                            <th>จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="user-table">
                        <%- include('userSection', { users: users }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="confirmPopup" class="popup-overlay">
        </div>
        <script>
            function searchUsers() {
                // 1. Target the table body where the rows will be injected
                const tableBody = document.getElementById('user-table');

                // 1. Grab the entire form
                const form = document.getElementById('search-form');

                // 2. MAGIC: Automatically grab all named inputs and turn them into URL parameters!
                // This turns your form into "id=123&username=Admin&role=Staff" instantly
                const params = new URLSearchParams(new FormData(form));

                let fetchUrl;

                fetchUrl = `/search-users?${params.toString()}`;

                // Give visual feedback that it's loading
                tableBody.style.opacity = '0.5';

                // 4. Fetch the new data
                fetch(fetchUrl)
                    .then(response => response.json())
                    .then(data => {
                        tableBody.innerHTML = data.html;
                        document.querySelector('.table-scroll-container').scrollTo({ top: 0 });
                    })
                    .catch(error => {
                        console.error('Error loading users:', error);
                        alert('เกิดข้อผิดพลาดในการค้นหา');
                    })
                    .finally(() => {
                        tableBody.style.opacity = '1';
                    });
            }
        </script>
</body>

</html>