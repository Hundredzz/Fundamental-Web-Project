<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('head') %>
    <title>เบิกสินค้าจำนวน</title>
    <link rel="stylesheet" href="/css/button.css">
    <link rel="stylesheet" href="/css/withdraw_layout.css">
    <link rel="stylesheet" href="/css/withdraw_form.css">
    <link rel="stylesheet" href="/css/receive_success.css">
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/errorBox.css">
</head>
<body>
    <%- include('nav') %>
    <div class="main-content" id="main-content">
        <h1 class="header-title">เบิกสินค้าออกคลัง</h1>
        <div class="withdraw-card">
            <div class="image-placeholder"><img src="/img/product_image/<%=product.img_path%>" alt=""></div>
            <h3 style="margin-bottom: 0;"><%= product.product_id %></h3>
            <h3 style="margin-top: 0;"><%= product.product_name %></h3>
            <form action="/withdraw/confirm/<%=product.product_id%>/<%=branchId%>" method="POST">
                <div class="qty-control">
                    <label>จำนวนที่ต้องการเบิก :</label>
                    <input type="number" name="quantity" value="1" >
                </div>
                <div class="qty-control">
                    <label>หมายเหตุ :</label>
                    <input type="text" name="note" >
                </div>
                <%if (typeof error !== 'undefined' && error === 'success') { %>
                    <div class="overlay">
            <div class="modal-box">
                <h1>เบิกจ่ายสินค้าสำเร็จ</h1>
                <button type="button" onclick="window.location.href='/withdraw/select-product?branch_id=<%=branchId%>'" class="style-button">ตกลง</a>
            </div>
        </div>
                    <%} else if (typeof error !== 'undefined' && error) { %>
        <div class="error-box" style="margin-bottom: 15px;">
            <span>⚠️</span>
            <span><%= error %></span>
        </div>
        <% } %>
                <div class="button-container">
                    <button type="button" class="style-button" onclick="window.location.href='/withdraw/select-product?branch_id=<%=branchId%>'">ยกเลิก</button>
                <button type="submit" class="style-button">ยืนยันการเบิก</button>
                </div>
            </form>
        </div>
    </div>
    
</body>
</html>