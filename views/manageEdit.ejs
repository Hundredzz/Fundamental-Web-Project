<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head') %>
        <title>แก้ไขผู้ใช้งาน</title>
        <link rel="stylesheet" href="/css/table.css">
        <link rel="stylesheet" href="/css/button.css">
        <link rel="stylesheet" href="/css/search.css">
        <link rel="stylesheet" href="/css/errorBox.css">
        <style>
            body {
                margin: 0;
                padding: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }

            .main-content {
                margin-top: 0;
            }

            .content {
                padding: 40px;
                width: 50%;
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            h1 {
                margin: 0;
                color: #75162D;
                align-self: center;
            }

            .row-group {
                display: flex;
                gap: 15px;
                width: 100%;
            }

            .input-1 {
                flex: 1;
                box-sizing: border-box;
            }

            .input-2 {
                flex: 2;
                box-sizing: border-box;
            }

            .full-width {
                width: 98%;
                box-sizing: border-box;
            }

            .button-group {
                display: flex;
                gap: 15px;
                margin-top: 10px;
            }

            .bt-popup-no {
                background: #FFFFFF;
                color: #75162D;
                border: 2px solid #75162D;
                width: 100%;
            }

            .bt-popup-yes {
                background: #75162D;
                color: #F2D9A0;
                border: none;
                width: 100%;
            }

            select[disabled] {
                cursor: not-allowed;
                opacity: 0.7;
            }

            @media screen and (max-width: 768px) {
                .row-group {
                    display: flex;
                    flex-direction: column;
                    gap: 15px;
                    width: 100%;
                    box-sizing: border-box;
                }

                input, select {
                    width: 100%;
                }

                .content {
                    padding: 0px;
                    width: 90%;
                    display: flex;
                    flex-direction: column;
                    gap: 20px;
                }
            }
        </style>
</head>

<body>
    <%- include('nav') %>
        <form action="<%= path %>" method="POST" class="content main-content" id="main-content">
            <h1>
                <%= title %>
            </h1>

            <div class="row-group">
                <!-- Employee ID dropdown -->
                <select class="input-1" name="employeeId" required <%=user ? 'disabled' : '' %>>
                    <option value="" disabled <%=!user ? 'selected' : '' %>>รหัสพนักงาน</option>
                    <% if (user) { %>
                        <!-- In edit mode: show only the current employee, locked -->
                        <option value="<%= user.employee_id %>" selected><%= user.employee_id %> — <%= user.first_name %> <%= user.last_name %></option>
                    <% } else { %>
                        <% employees.forEach(emp => { %>
                            <option value="<%= emp.employee_id %>"><%= emp.employee_id %> — <%= emp.first_name %> <%= emp.last_name %></option>
                        <% }) %>
                    <% } %>
                </select>
                <!-- Hidden field so the value is still submitted when disabled in edit mode -->
                <% if (user) { %>
                    <input type="hidden" name="employeeId" value="<%= user.employee_id %>">
                <% } %>

                <input type="text" class="input-2" name="userName" placeholder="ชื่อผู้ใช้"
                    value="<%= user ? user.username : '' %>">
            </div>

            <input type="password" name="password" class="full-width"
                placeholder="<%= user ? 'รหัสผ่านใหม่ (เว้นว่างไว้ถ้าไม่ต้องการเปลี่ยน)' : 'รหัสผ่าน' %>" <%=user ? '' : 'required' %>>
            <input type="password" name="cPassword" class="full-width"
                placeholder="<%= user ? 'ยืนยันรหัสผ่านใหม่ (เว้นว่างไว้ถ้าไม่ต้องการเปลี่ยน)' : 'ยืนยันรหัสผ่าน' %>"
                <%=user ? '' : 'required' %>>

            <div class="row-group">
                <select class="input-1" name="role" required>
                    <option value="" disabled <%=!user ? 'selected' : '' %>>เลือกบทบาท</option>
                    <option value="Manager" <%=user && user.role==='Manager' ? 'selected' : '' %>>ผู้จัดการ</option>
                    <option value="Staff" <%=user && user.role==='Staff' ? 'selected' : '' %>>เจ้าหน้าที่คลัง</option>
                    <option value="StaffBranch" <%=user && user.role==='StaffBranch' ? 'selected' : '' %>>เจ้าหน้าที่สาขา</option>
                </select>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-box">
                    <span>⚠️</span>
                    <span>
                        <%= error %>
                    </span>
                </div>
            <% } %>

            <div class="button-group">
                <button class="bt-popup-no style-button" type="button"
                    onclick="window.location.href = '/manage'">ยกเลิก</button>
                <button class="bt-popup-yes style-button" type="submit">บันทึกข้อมูล</button>
            </div>

        </form>
</body>

</html>
