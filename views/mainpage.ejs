<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head') %>
    <title>mainpage</title>
    <link rel="stylesheet" href="/css/button.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <%- include('nav') %>
    <% if (user.role!='StaffBranch'){ %>
    <div class="notification-bell" onclick="toggleNotiDropdown(event)">
        <img src="/img/bell.svg" class="bell-icon" alt="Notification">
        <span class="badge" id="noti-count" style="display: none;">0</span>
        
        <div id="noti-dropdown" class="noti-dropdown">
            <div class="noti-header">สินค้าใกล้หมดอายุ (30 วัน)</div>
            <div id="noti-list" class="noti-list">
                <div class="noti-item empty">กำลังโหลด...</div>
            </div>
            <button class="noti-footer style-button" onclick="window.location.href = '/expiry'">
                ดูทั้งหมด
            </button>
        </div>
    </div>
    <% } %>
    <div class="main-content" id="main-content">
        <div class="big">
            <div class="small">
                <h5>สินค้าทั้งหมด</h5>
                <h1><%= dashData ? Number(dashData.totalProducts).toLocaleString('en-US') : 0 %> รายการ</h1>
                <p>อัปเดตล่าสุด : <%= dashData ? dashData.lastUpdate : '-' %></p>
            </div>

            <div class="small">
                <h5>สต๊อกคงเหลือ</h5>
                <h1><%= dashData ? Number(dashData.totalStock).toLocaleString('en-US') : 0 %> ชิ้น</h1>
                <p>
                    <% if (dashData && dashData.dailyChange > 0) { %>
                        <span class="text-green">+<%= Number(dashData.dailyChange).toLocaleString('en-US') %> ชิ้น</span> จากเมื่อวาน
                    <% } else if (dashData && dashData.dailyChange < 0) { %>
                        <span class="text-red"><%= Number(dashData.dailyChange).toLocaleString('en-US') %> ชิ้น</span> จากเมื่อวาน
                    <% } else { %>
                        ไม่มีการเปลี่ยนแปลงจากเมื่อวาน
                    <% } %>
                </p>
            </div>
        </div>

        <div class="big">
            <div class="small">
                <h5 style="color: #75162E;">ใกล้หมดอายุ (30 วัน)</h5>
                <h1 style="color: #75162E;" class="<%= (dashData && dashData.expiringSoon > 0) ? 'text-orange' : '' %>">
                    <%= dashData ? Number(dashData.expiringSoon).toLocaleString('en-US') : 0 %> รายการ
                </h1>
                <p>ต้องดำเนินการเร่งด่วน</p>
            </div>

            <div class="small">
                <h5>หมดอายุแล้ว</h5>
                <h1 style="color: #75162E;" class="<%= (dashData && dashData.expired > 0) ? 'text-red' : '' %>">
                    <%= dashData ? Number(dashData.expired).toLocaleString('en-US') : 0 %> รายการ
                </h1>
                <p>ต้องตรวจสอบและแยกออกจากคลัง</p>
            </div>
        </div>
    </div>
    <div id="overlay" class="overlay" onclick="togglePlusMenu()"></div>
    <% if ( user.role!='Manager' ) { %>

    <div id="fab-menu" class="fab-menu">
        <% if ( user.role=='Staff' ) { %>
        <div class="menu-item" onclick="window.location.href='/receive'">
            <img src="/img/plus.svg" style="width: 24px; margin-right: 10%" >
                <p>เพิ่มสินค้าเข้า</p>
        </div>
        <% } %>
        <div class="menu-item" onclick="window.location.href='/withdraw'">
            <img src="/img/minus.svg" style="width: 24px; margin-right: 10%">
            <p>เบิกสินค้าออก</p>
        </div>
        <div class="menu-item" onclick="window.location.href='/scan'">
            <img src="/img/scan.svg" style="width: 24px; margin-right: 10%">
            <p>สแกนบาร์โค้ด</p>
        </div>
    </div>

    <div class="add-icon-container" onclick="togglePlusMenu()">
        <img src="/img/add.svg" id="main-icon" class="add-icon">
    </div>
    <% } %>

    

    <script>
        function togglePlusMenu() {
            const body = document.body;
            const mainIcon = document.getElementById('main-icon');
            body.classList.toggle('menu-open');
            if (body.classList.contains('menu-open')) {
                mainIcon.src = "/img/add_45.svg";
            } else {
                mainIcon.src = "/img/add.svg";
            }
        }
    

        
        async function toggleNotiDropdown(event) {
            event.stopPropagation(); 
            const dropdown = document.getElementById('noti-dropdown');
            const isVisible = dropdown.style.display === 'block';
            
            if (!isVisible) {
                dropdown.style.display = 'block';
                await loadLatestNotifications(); 
            } else {
                dropdown.style.display = 'none';
            }
        }

        
        async function loadLatestNotifications() {
            try {
                const res = await fetch('/api/notifications/latest');
                const data = await res.json();
                const list = document.getElementById('noti-list');
                
                if (data.items && data.items.length > 0) {
                    list.innerHTML = data.items.map(item => `
                        <div class="noti-item">
                            ⚠️ <b>${item.product_name}</b><br>
                            <small>เหลือ ${item.quantity} ชิ้น - <span class="text-red">หมดอายุ ${item.exp_date}</span></small>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<div class="noti-item empty">ไม่มีสินค้าใกล้หมดอายุ</div>';
                }
            } catch (err) {
                console.error("Load latest noti failed:", err);
            }
        }

        
        async function updateNotificationBadge() {
            try {
                const response = await fetch('/api/notifications/count');
                const data = await response.json();
                const badge = document.getElementById('noti-count'); 
                
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (err) {
                console.error('Failed to fetch notification count:', err);
            }
        }

        
        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('noti-dropdown');
            const bell = document.querySelector('.notification-bell');
            if (!bell.contains(event.target)) {
                dropdown.style.display = 'none';
            }
        });

        
        updateNotificationBadge();
    </script>
</body>

</html>