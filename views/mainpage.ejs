<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('head') %>
    <title>mainpage</title>
    <style>
        body {
            margin: 0;
            background: url(/img/bg.png) repeat, #3B010B;
            overflow-x: hidden;
        }
        h5 {
            font-size: 18px;
            color: black;
        }
        p {
            font-size: 14px;
            color: black;
        }
        h1 {
            color: black;
            margin: 5%;
        }
        .big {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .small {
            width: 30%;
            padding: 1%;
            padding-left: 3%;
            margin: 1%;
            background-color: #ffffff;
            color: #3B010B;
            border: 1px solid #f2e5c6;
            border-radius: 10px;
            text-align: left;
            box-shadow: 0 0 8px #3B010B;
        }
        .notification-bell {
            position: absolute;
            top: 25px; /* ปรับระยะห่างจากขอบด้านบน */
            right: 3vw; /* ปรับระยะห่างจากขอบด้านขวา */
            z-index: 10; /* ให้อยู่ด้านบนสุด */
        }
        .search-icon {
            position: absolute;
            right: 26vw;
            top: 40%;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        .bell-icon {
            position: absolute;
            right: 2.5vw;
            top: 40%;
            width: 30px;
            height: 30px;
            cursor: pointer;
        }
        .add-icon {
            position: absolute;
            right: 2.5vw;
            bottom: 5%;
            width: 50px;
            height: 50px;
            cursor: pointer;
        }
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1;
            transition: 0.3s;
        }
        .fab-menu {
            display: none;
            position: fixed;
            right: 3.5vw;
            bottom: 15%;
            z-index: 2;
            flex-direction: column;
            align-items: flex-end;
            gap: 15px;
        }
        .menu-item {
            display: flex;
            width: 100%;
            align-items: center;
            cursor: pointer;
            background: white;
            padding: 5px 10px;
            margin-bottom: 5%;
            border-radius: 10px;
            font-size: 14px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .add-icon-container {
            position: fixed;
            right: 1vw;
            bottom: 5%;
            z-index: 3;
        }
        .menu-open #fab-menu,
        .menu-open #overlay {
            display: flex;
            transition: 0.3s;
        }
        @media screen and (max-width: 600px) {
            .big {
                width: 100vw;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }
            .small {
                width: 50vw;
            }
        }
    </style>
</head>

<body>
    <%- include('nav') %>
    <div class="notification-bell">
        <a href="..."><img src="/img/bell.svg" class="bell-icon"></a>
    </div>
    <div class="main-content" id="main-content">
        <div class="big">
            <div class="small">
                <h5>สินค้าทั้งหมด</h5>
                <h1><%= dashData ? Number(dashData.totalProducts).toLocaleString('en-US') : 0 %> รายการ</h1>
                <p>อัปเดตล่าสุด : <%= dashData ? dashData.lastUpdate : '-' %></p>
            </div>

            <div class="small">
                <h5>สต๊อกคงเหลือ</h5>
                <h1><%= dashData ? Number(dashData.totalStock).toLocaleString('en-US') : 0 %> ชิ้น</h1>
                <p>
                    <% if (dashData && dashData.dailyChange > 0) { %>
                        <span class="text-green">+<%= Number(dashData.dailyChange).toLocaleString('en-US') %> ชิ้น</span> จากเมื่อวาน
                    <% } else if (dashData && dashData.dailyChange < 0) { %>
                        <span class="text-red"><%= Number(dashData.dailyChange).toLocaleString('en-US') %> ชิ้น</span> จากเมื่อวาน
                    <% } else { %>
                        ไม่มีการเปลี่ยนแปลงจากเมื่อวาน
                    <% } %>
                </p>
            </div>
        </div>

        <div class="big">
            <div class="small">
                <h5>ใกล้หมดอายุ (30 วัน)</h5>
                <h1 class="<%= (dashData && dashData.expiringSoon > 0) ? 'text-orange' : '' %>">
                    <%= dashData ? Number(dashData.expiringSoon).toLocaleString('en-US') : 0 %> รายการ
                </h1>
                <p>ต้องดำเนินการเร่งด่วน</p>
            </div>

            <div class="small">
                <h5>หมดอายุแล้ว</h5>
                <h1 class="<%= (dashData && dashData.expired > 0) ? 'text-red' : '' %>">
                    <%= dashData ? Number(dashData.expired).toLocaleString('en-US') : 0 %> รายการ
                </h1>
                <p>ต้องตรวจสอบและแยกออกจากคลัง</p>
            </div>
        </div>
    </div>
    <div id="overlay" class="overlay" onclick="togglePlusMenu()"></div>

    <div id="fab-menu" class="fab-menu">
        <div class="menu-item">
            <img src="/img/plus.svg" style="width: 24px; margin-right: 10%";>
            <p>รับสินค้าเข้า</p>
        </div>
        <div class="menu-item">
            <img src="/img/minus.svg" style="width: 24px; margin-right: 10%">
            <p>เบิกสินค้าออก</p>
        </div>
        <div class="menu-item">
            <img src="/img/scan.svg" style="width: 24px; margin-right: 10%">
            <p>สแกนบาร์โค้ด</p>
        </div>
    </div>

    <div class="add-icon-container" onclick="togglePlusMenu()">
        <img src="/img/add.svg" id="main-icon" class="add-icon">
    </div>

    <script>
        function togglePlusMenu() {
            const body = document.body;
            const mainIcon = document.getElementById('main-icon');
            body.classList.toggle('menu-open');
            if (body.classList.contains('menu-open')) {
                mainIcon.src = "/img/add_45.svg";
            } else {
                mainIcon.src = "/img/add.svg";
            }
        }
    </script>
</body>

</html>