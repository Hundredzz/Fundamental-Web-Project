<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เบิกสินค้าออกคลัง</title>
    <link rel="stylesheet" href="/css/withdraw_layout.css">
    <link rel="stylesheet" href="/css/withdraw_branch.css">
    <link rel="stylesheet" href="/css/nav.css">
</head>
<body>
    <%- include('nav') %>
    <div class="main-content">
    <h1 class="header-title">เบิกสินค้าออกคลัง</h1>
    <div class="branch-card">
        <p>กรุณาเลือกสาขาปลายทาง</p>
        <form action="/withdraw/select-product" method="GET">
            <select name="branch_id" class="branch-select" onchange="this.form.submit()">
                <option value="">เลือกสาขา...</option>
                <option value="1">สาขาที่ 1</option>
                <option value="2">สาขาที่ 2</option>
            </select>
        </form>
    </div>
    <script src="/script/nav.js"></script>
</div>
</body>
</html>