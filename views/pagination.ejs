<% if (totalPages> 1) { %>
                    <div class="pagination-container">
                        <div class="pagination">
                            <% if (currentPage> 1) { %>
                                <button href="#" class="page-btn" data-page="1"
                                    onclick="changePage(this, '<%= ejsName %>', '<%= branchId %>');">&laquo;</button>
                                <% } else { %>
                                    <span class="disabled">&laquo;</span>
                                    <% } %>

                                        <% if (currentPage> 1) { %>
                                            <button href="#" class="page-btn" data-page="<%= currentPage - 1 %>"
                                                onclick="changePage(this, '<%= ejsName %>', '<%= branchId %>');">&lsaquo;</button>
                                            <% } else { %>
                                                <span class="disabled">&lsaquo;</span>
                                                <% } %>

                                                    <span>
                                                        <%= currentPage %>
                                                    </span>

                                                    <% if (currentPage < totalPages) { %>
                                                        <button href="#" class="page-btn"
                                                            data-page="<%= currentPage + 1 %>"
                                                            onclick="changePage(this, '<%= ejsName %>', '<%= branchId %>');">&rsaquo;</button>
                                                        <% } else { %>
                                                            <span class="disabled">&rsaquo;</span>
                                                            <% } %>

                                                                <% if (currentPage < totalPages) { %>
                                                                    <button href="#" class="page-btn"
                                                                        data-page="<%= totalPages %>"
                                                                        onclick="changePage(this, '<%= ejsName %>', '<%= branchId %>');">&raquo;</button>
                                                                    <% } else { %>
                                                                        <span class="disabled">&raquo;</span>
                                                                        <% } %>
                        </div>
                    </div>
                    <% } %>
                        