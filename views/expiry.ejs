<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('head') %>
    <title>แจ้งเตือนสินค้าใกล้หมดอายุ</title>
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/history.css">
</head>
<body>
    <%- include('nav') %>
    <div class="main-content " id="main-content">
    <h1>⚠️ สินค้าที่กำลังจะหมดอายุ (ภายใน 30 วัน)</h1>
    <div class="table-scroll-container">
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>รหัสสินค้า</th>
                <th>ชื่อสินค้า</th>
                <th>รหัสล็อต</th>
                <th>จำนวนคงเหลือ</th>
                <th>วันหมดอายุ</th>
            </tr>
        </thead>
        <tbody>
            <% if (expiringProducts.length === 0) { %>
                <tr><td colspan="5">ไม่มีสินค้าที่กำลังจะหมดอายุ</td></tr>
            <% } else { %>
                <% expiringProducts.forEach(p => { %>
                    <tr>
                        <td><%= p.sku %></td>
                        <td><%= p.product_name %></td>
                        <td><%= p.lot_batch_code %></td>
                        <td><%= p.quantity %></td>
                        <td style="background-color: #ffcccc;"><%= p.exp_date %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
    </div>
    </div>
</body>
</html>