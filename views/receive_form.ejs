<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('head') %>
    <title>กรอกข้อมูลสินค้า</title>
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/button.css">
    <link rel="stylesheet" href="/css/receive_form.css">
    <link rel="stylesheet" href="/css/receive_success.css">
    <link rel="stylesheet" href="/css/errorBox.css">
</head>
<body>
    <%- include('nav') %>
        <div class="main-content" id="main-content">
            <h1 class="header-title">กรอกข้อมูลสินค้า</h1>
            
            <div class="form-card">
                <div class="product-display">
                <h2 style="font-size: 1.2rem;"><%= product.product_id %></h2>
                <h2 style="font-size: 1.2rem;"><%= product.product_name %></h2>
                </div>
                
                <form action="/save-stock/<%= product.product_id %>" method="POST">

                    <div class="form-group">
                        <label>จำนวนชิ้น :</label>
                        <input type="number" name="quantity" required>
                    </div>
                    <div class="form-group">
                        <label>เลข Lot/Batch :</label>
                        <input type="text" name="lot_number" required>
                    </div>
                    <div class="form-group">
                        <label>วันผลิต :</label>
                        <input type="date" name="mfd_date" required>
                    </div>
                    <div class="form-group">
                        <label>วันหมดอายุ :</label>
                        <input type="date" name="exp_date" required>
                    </div>
                    <div class="form-group">
                        <label>ซัพพลายเออร์ :</label>
                        <p style="width: 100%;"><%= product.supplier_name %></p>
                    </div>
                    <div class="form-group">
                        <label>หมายเหตุ :</label>
                        <input type="text" name="remark">
                    </div>
                    <%if (typeof error !== 'undefined' && error === 'success') { %>
                    <div class="overlay">
            <div class="modal-box">
                <h1>รับสินค้าสำเร็จ</h1>
                <button onclick="window.location.href='/receive'" class="style-button">ตกลง</a>
            </div>
        </div>
                    <%} else if (typeof error !== 'undefined' && error) { %>
        <div class="error-box" style="margin-bottom: 15px;">
            <span>⚠️</span>
            <span><%= error %></span>
        </div>
        <% } %>
                <div class="button-container">
                    <button type="button" class="style-button" onclick="window.location.href='/receive'">ยกเลิก</button>
                    <button type="submit" class="style-button">ยืนยันการรับเข้า</button>
                </div> 
                </form>
                
            </div>
        </div>
    </div>
</body>
</html>