<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Report</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/search.css">
    <style>
        body {
            margin: 0;
            background: url(/img/big-background.png) repeat, #3B010B;
            background-size: cover;
            overflow-x: hidden;

        }

        .main {
            margin: 0;
            display: flex;
            flex-direction: column;
            width: 100%;
            min-height: 100vh;
            justify-content: center;
            align-items: center;
        }

        .container {
            background-color: #75162D;
            margin: 0;
            width: 40%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }
        h1{
            color: #75162D;
        }
        .smallCon{
            display: flex;
            width: 100%;
            justify-content: center;
            align-items: center;
            color:#F2D9A0 ;
        }
        select{
            width: 60%;
            margin: 2.5%;
        }
        input{
            width: 60%;
            margin: 2.5%;
        }
        button{
            margin-top: 2.5%;
            margin-bottom: 0;
        }
    </style>
</head>

<body>
    <div class="main">
        <h1>ระบุเงื่อนไข</h1>
        <div class="container">
            <div class="smallCon">
                <p>วันที่</p><input type="date" name="date">
            </div>
            <div class="smallCon">
                <p>หมวดหมู่</p>
                <select>
                    <option>เริ่มต้น</option>
                    <option>#</option>
                    <option>!</option>
                    <option>%</option>
                </select>
            </div>
            <button>สร้างรายงาน</button>
        </div>
    </div>
</body>

</html>