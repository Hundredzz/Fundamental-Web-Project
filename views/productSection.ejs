<div class="product-container">
    <% if (data && data.length> 0) { %>
        <% data.forEach(product=> { %>
            <div class="product-card">
                <img src="/img/product_image/<%= product.img_path %>" alt="">
                <h2>
                    <%= product.product_name %>
                </h2>
                <p>รหัสสินค้า : <%= product.product_id %>
                </p>
                <p>แบรนด์ : <%= product.brand_name %>
                </p>
                <p>ประเภท : <%= product.category_name %>
                </p>
                <p style="font-size: 0.9rem;">คงเหลือ : <%= product.total_quantity%>
                </p>
                <div style="text-align: center; margin-bottom: 10px;">
                    <svg class="barcode" 
                        jsbarcode-format="CODE128" 
                        jsbarcode-value="<%= product.product_id %>" 
                        jsbarcode-height="35"
                        jsbarcode-fontSize="14">
                    </svg>
                </div>
                <div class="button-container">
                    <button class="detail-btn" data="<%=product.product_id%>"
                        onclick="showDetail(this)">ดูรายละเอียด</button>
                    <form action="/edit-product/<%= product.product_id %>">
                        <button type="submit"><img src="/img/edit-icon.svg" alt=""></button>
                    </form>
                    <form action="">
                        <button type="button" onclick="deleteProduct('<%= product.product_id %>')">
        <img src="/img/delete-icon.svg" alt="Delete">
    </button>
                    </form> 
                </div>
            </div>
            <% }) %>
                <%- include('pagination', {ejsName :ejsName,currentPage: currentPage, totalPages: totalPages}); %>
            <% } else { %>
                            <div class="not-found-message">
                                <h1>ไม่พบสินค้าที่คุณค้นหา</h1>
                                <p>กรุณาลองใช้คำค้นหาอื่น</p>
                                <button onclick="window.location.href='/product'"
                                    class="reset-search-btn">ลองอีกครั้ง</button>
                            </div>
                            <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<script>
    JsBarcode(".barcode").init();
</script>