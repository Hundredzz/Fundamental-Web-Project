<div class="product-container">
    <% if (data && data.length> 0) { %>
        <% data.forEach(product=> { %>
            <div class="product-card">
                <img src="/img/product_image/<%= product.img_path %>" alt="">
                <h2>
                    <%= product.product_name %>
                </h2>
                <p>แบรนด์ : <%= product.brand_name %>
                </p>
                <p>ประเภท : <%= product.category_name %>
                </p>
                <p>คงเหลือ : <%= product.total_quantity%>
                </p>
                <div class="button-container">
                    <button class="detail-btn" data="<%=product.product_id%>"
                        onclick="showDetail(this)">ดูรายละเอียด</button>
                    <form action="/edit-product/<%= product.product_id %>">
                        <button type="submit"><img src="/img/edit-icon.svg" alt=""></button>
                    </form>
                    
                        <button type="submit" onclick="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบสินค้านี้?');">
                            <img src="/img/delete-icon.svg" alt="Delete">
                        </button>
                </div>
            </div>
            <% }) %>
                <% if (totalPages> 1) { %>
                    <div class="pagination-container">
                        <div class="pagination">
                            <% if (currentPage> 1) { %>
                                <button href="#" class="page-btn" data-page="1"
                                    onclick="changePage(this);">&laquo;</button>
                                <% } else { %>
                                    <span class="disabled">&laquo;</span>
                                    <% } %>

                                        <% if (currentPage> 1) { %>
                                            <button href="#" class="page-btn" data-page="<%= currentPage - 1 %>"
                                                onclick="changePage(this);">&lsaquo;</button>
                                            <% } else { %>
                                                <span class="disabled">&lsaquo;</span>
                                                <% } %>

                                                    <span>
                                                        <%= currentPage %>
                                                    </span>

                                                    <% if (currentPage < totalPages) { %>
                                                        <button href="#" class="page-btn"
                                                            data-page="<%= currentPage + 1 %>"
                                                            onclick="changePage(this);">&rsaquo;</button>
                                                        <% } else { %>
                                                            <span class="disabled">&rsaquo;</span>
                                                            <% } %>

                                                                <% if (currentPage < totalPages) { %>
                                                                    <button href="#" class="page-btn"
                                                                        data-page="<%= totalPages %>"
                                                                        onclick="changePage(this);">&raquo;</button>
                                                                    <% } else { %>
                                                                        <span class="disabled">&raquo;</span>
                                                                        <% } %>
                        </div>
                    </div>
                    <% } %>
                        <% } else { %>
                            <div class="not-found-message">
                                <h1>ไม่พบสินค้าที่คุณค้นหา</h1>
                                <p>กรุณาลองใช้คำค้นหาอื่น</p>
                                <button onclick="window.location.href='/product'"
                                    class="reset-search-btn">ลองอีกครั้ง</button>
                            </div>
                            <% } %>
</div>