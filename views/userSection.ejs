<% if (users && users.length> 0) { %>
    <% users.forEach(user=> { %>
        <tr>
            <td>
                <%= user.employee_id %>
            </td>
            <td>
                <%= user.username %>
            </td>
            <td>
                <%= user.first_name %>
                    <%= user.last_name %>
            </td>
            <td>
                <% if (user.role === "Manager"){ %>
                    ผู้จัดการ
                <%} else if (user.role === "Staff"){%>
                    เจ้าหน้าที่คลัง
                <%} else if (user.role === "StaffBranch"){%>
                    เจ้าหน้าที่สาขา
                <%}%>
            </td>
            <td>
                <img src="/img/edit-icon.svg" id="editData-<%= user.username %>" onclick="window.location.href='/edit-user/<%= user.user_id %>'" class="icon">
                <img src="/img/delete-icon.svg" id="deleteData-<%= user.username %>"
                    onclick="confirmDetail('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้', '<%= user.username %>', '/delete-user/<%= user.user_id %>')"
                    class="icon">
                <% if (user.status === 'Inactive'){ %>
                <img src="/img/ban.svg" class="icon"
                    onclick="confirmDetail('คุณแน่ใจหรือไม่ว่าต้องการปลดระงับผู้ใช้', '<%= user.username %>', '/toggle-ban/<%= user.user_id %>/<%=user.status%>')">
                <%} else {%>
                    <img src="/img/notban-icon.svg" class="icon"
                    onclick="confirmDetail('คุณแน่ใจหรือไม่ว่าต้องการระงับผู้ใช้', '<%= user.username %>', '/toggle-ban/<%= user.user_id %>/<%=user.status%>')">
                    <%}%>
                </td>
        </tr>
        <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; padding: 20px;">ไม่พบข้อมูลผู้ใช้งาน</td>
                </tr>
                <% } %>